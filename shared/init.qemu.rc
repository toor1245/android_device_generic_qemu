on init && property:ro.debuggable=0 && property:ro.build.type=user
    start console

on fs
    mount_all /vendor/etc/fstab.qemu

on boot
    setprop service.adb.tcp.port 5555
    start adbd

    setprop sys.boot_completed 1

    exec_start update_verifier

service dhcp_eth0 /vendor/bin/dhcpclient -i eth0
    class core
    user root
    group root

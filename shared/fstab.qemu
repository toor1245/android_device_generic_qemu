# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#<src>                       <mnt_point> <type>  <mnt_flags and options>    <fs_mgr_flags>
system                       /system    ext4 noatime,ro                     wait,logical,first_stage_mount,slotselect,avb=vbmeta_system
vendor                       /vendor    ext4 noatime,ro                     wait,logical,first_stage_mount,slotselect,avb=vbmeta_vendor
/dev/block/by-name/userdata  /data      ext4 noatime,nosuid,nodev           wait,check
/dev/block/by-name/metadata  /metadata  ext4 noatime,nosuid,nodev,discard   wait,formattable,first_stage_mount
/dev/block/by-name/boot      /boot      emmc defaults                       slotselect,avb=boot,first_stage_mount
/dev/block/by-name/init_boot /init_boot emmc defaults                       slotselect,avb=init_boot,first_stage_mount
/dev/block/by-name/misc      /misc      emmc defaults                       wait
/dev/block/by-name/vbmeta    /vbmeta    emmc defaults                       slotselect,first_stage_mount

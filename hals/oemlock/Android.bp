rust_binary {
    name: "android.hardware.oemlock-service.optee",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["oemlock-optee.rc"],
    vintf_fragments: ["oemlock-optee.xml"],
    srcs: ["main.rs"],
    rustlibs: ["libbinder_rs", "android.hardware.oemlock-V1-rust"],
    static_libs: ["libavb_optee"],
    shared_libs: ["libteec"],
}

rust_binary {
    name: "oemlock-cli",
    vendor: true,
    srcs: ["client/main.rs"],
    rustlibs: ["libbinder_rs", "android.hardware.oemlock-V1-rust"],
}

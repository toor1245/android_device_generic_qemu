type oemlock_cli, domain;
type oemlock_cli_exec, exec_type, vendor_file_type, file_type;

userdebug_or_eng(`
  domain_auto_trans(shell, oemlock_cli_exec, oemlock_cli)
  allow oemlock_cli shell:fd use;

  allow oemlock_cli adbd:fd use;
  allow oemlock_cli adbd:unix_stream_socket { read write };
  allow oemlock_cli devpts:chr_file rw_file_perms;
  allow oemlock_cli console_device:chr_file rw_file_perms;

  hal_client_domain(oemlock_cli, hal_oemlock)
  binder_use(oemlock_cli)
')
